# Allow-list: ignore everything, then un-ignore tracked paths.
*
!*/

!.gitignore
!.gitattributes
!LICENSE
!README.md
!CHANGELOG.adoc
!AGENTS.md
!dub.sdl

!docs/
!docs/**
!changelog-details/
!changelog-details/**
!apps/
!apps/**
!libs/
!libs/**
!brand/
!brand/**
!.github/
!.github/**
!LICENSING.adoc
!TRADEMARK.adoc
!NOTICE

# Tracked trees can still spawn junk; put it back in the bitbucket.
apps/**/node_modules/
apps/**/node_modules/**
apps/**/.vinxi/
apps/**/.vinxi/**
apps/**/.output/
apps/**/.output/**
apps/**/dist/**
**/.DS_Store
**/*.lib
**/*.obj
**/*.exe
**/*.pdb
**/bin/
**/build/

# Dub dumps .lib next to sources when targetPath is local lib/
/libs/core/lib/
/libs/encode/lib/
/libs/epson/lib/
/libs/escl/lib/
/libs/fixture/lib/
/libs/image/lib/
/libs/twain/lib/
/libs/wia/lib/

# Never commit workstation notes, even if someone drops a copy here.
MEMORIES.md
**/MEMORIES.md
.env
**/.env
*.local.json5
**/*.local.json5
!/.editorconfig
